# 네이버 검색광고 API
# 검색광고 > 도구 > API 사용관리 (https://manage.searchad.naver.com) 에서 발급
# CUSTOMER_ID 는 검색광고 로그인 후 우측 상단 계정 정보의 "고객 ID" (숫자)
NAVER_AD_ACCESS_KEY=
NAVER_AD_SECRET_KEY=
NAVER_AD_CUSTOMER_ID=

# GA4 (마인드팡(인포) 속성 — info/good/ss/hub 4개 도메인)
GA4_PROPERTY_ID=

# 구글 OAuth (애드센스·GA4 조회용 — client_secret*.json 의 값)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
ADSENSE_REFRESH_TOKEN=

# 구글 로그인 (배포 시에는 "웹 애플리케이션" 유형 클라이언트가 필요)
GOOGLE_LOGIN_CLIENT_ID=
GOOGLE_LOGIN_CLIENT_SECRET=
# 세션 서명용 임의의 긴 문자열
AUTH_SECRET=
# 로그인 허용 계정 (쉼표로 여러 개)
ALLOWED_EMAILS=tedevspace@gmail.com

# 배포 주소를 고정하고 싶을 때 (없으면 요청 헤더에서 자동 판별)
APP_ORIGIN=

# 카카오 키워드광고
# 광고계정번호는 플랫폼의 K 접두어를 뗀 숫자만 넣는다
KAKAO_AD_ACCOUNT_ID=
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=

# ── 글 작성 (/write) ──────────────────────────────────────
# 주제 하나로 4개 사이트 체인 글을 만들어 초안으로 올린다.
ANTHROPIC_API_KEY=

# 워드프레스 4개 사이트 공통 계정
WP_USER=mindpang
WP_PASS=

# 애플리케이션 비밀번호가 있으면 이쪽을 우선 쓴다(쿠키+nonce 보다 안정적).
# wp-admin > 사용자 > 프로필 > Application Passwords 에서 발급
# WP_APP_PASS_HUB=
# WP_APP_PASS_SS=
# WP_APP_PASS_GOOD=
# WP_APP_PASS_INFO=

# 제목·본문에 들어가면 안 되는 브랜드명 (쉼표 구분, 네이버 상표 키워드 광고 제한)
CHAIN_BRAND_BLOCKLIST=

# CHAIN_MODEL_MAIN=claude-opus-5
# CHAIN_MODEL_FIX=claude-sonnet-5
